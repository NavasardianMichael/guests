generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An account. Signs in with a password, Google, or both.
model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  fullName               String
  /// Null for a Google-only account.
  passwordHash           String?
  googleId               String?   @unique
  avatarUrl              String?
  /// Set when the inbox was proven: Google vouched for it, or the owner opened an emailed
  /// link (verification or password reset). A password account cannot sign in until it is
  /// set (routes/identity.ts), and Google linking claims an account where it is not
  /// (routes/identity-google.ts).
  emailVerifiedAt        DateTime?
  /// The pending verification link (hashed, like the reset token). Cleared once used.
  emailVerifyTokenHash   String?   @unique
  emailVerifyExpiresAt   DateTime?
  /// Bumped by password reset/change and account delete; every session cookie minted
  /// against an older value stops being honoured (middleware/auth.ts).
  tokenVersion           Int       @default(0)
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  /// Last request made with this account's session, kept to the day (middleware/auth.ts). An
  /// account unused for a year is deleted with its lists (services/retention.ts).
  lastActiveAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  lists      GuestList[]
  payments   Payment[]
  photoReads PhotoRead[]
}

/// One guest list and how it prints. `content` and `design` are JSON coerced by
/// services/listDocument.ts on every write: the shape is the web's `ListContent` / `ListDesign`.
///
/// Owned by an account (`userId`) or by a browser's guest key (`guestKeyHash`, lib/guest.ts) —
/// exactly one of the two, enforced by a CHECK constraint in the migration. Signing in moves a
/// guest's lists to the account.
model GuestList {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the guest cookie's key; the key itself is never stored.
  guestKeyHash String?
  title        String
  /// Denormalised from `design` / `content` for listing without parsing JSON.
  templateId   String
  kind         String
  guestCount   Int       @default(0)
  content      Json
  design       Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payments  Payment[]
  downloads PdfDownload[]

  @@index([userId, updatedAt])
  @@index([guestKeyHash, updatedAt])
  /// For the retention sweep over guest lists (services/retention.ts).
  @@index([updatedAt])
}

enum PaymentStatus {
  pending
  succeeded
  failed
  /// Was `succeeded`, then refunded or voided in the bank's panel: its days no longer count.
  refunded
}

enum PaymentGateway {
  ameria
  mock
}

/// One checkout attempt for one **access pass** (docs/PAYMENTS.md): `PASS_DAYS` of everything —
/// every template and kind, clean pages, unlimited downloads — for its owner, an account or a
/// browser's guest key until they sign in. A `succeeded` row is the pass; the window is computed
/// from the rows' `paidAt` (services/entitlement.ts#accessWindow), a pass bought while one runs
/// adding its days on top. There is no other record of who may print what.
///
/// Kept when the account or the list is deleted: it is the accounting record, so the links
/// are nullable. `listId` is only the list the purchase was started from (where the buyer
/// returns to).
model Payment {
  id               String         @id @default(cuid())
  /// The integer order number a gateway needs (Ameria's `OrderID`, plus an offset).
  orderNumber      Int            @unique @default(autoincrement())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// A guest buyer's key (lib/guest.ts), hashed; moved to `userId` when they sign in.
  guestKeyHash     String?
  listId           String?
  list             GuestList?     @relation(fields: [listId], references: [id], onDelete: SetNull)
  /// Whole drams.
  amount           Int
  currency         String         @default("AMD")
  gateway          PaymentGateway
  gatewayPaymentId String?        @unique
  status           PaymentStatus  @default(pending)
  failureReason    String?
  paidAt           DateTime?
  /// When the bank first sent the buyer back to us. Null: they never came back — the bank's
  /// page may still be open in another tab (`findOpenPayment`).
  returnedAt       DateTime?
  /// When the buyer was sent back to this payment's still-open bank page rather than a new
  /// order (`resumeOpenPayment`). Once only: a second time, a new order is started.
  reopenedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  downloads PdfDownload[]

  @@index([userId, status])
  @@index([guestKeyHash, status])
}

/// One PDF the server sent in full (routes/lists.ts, routes/pdf.ts), written once the last byte
/// is handed to the connection. Under an access pass (`paymentId`) it is the proof, next to the
/// payment's, that what was paid for was delivered — what the refund policy's "could not
/// download it" claim is checked against. A saved list's free print is recorded too: any
/// download within the year keeps the list from the retention sweep (services/retention.ts).
/// A guest's local draft printed free is not (`listId` is null for a draft). Kept, like
/// `Payment`, when the list or account goes.
model PdfDownload {
  id         String     @id @default(cuid())
  listId     String?
  list       GuestList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  templateId String
  /// The `succeeded` payment (the latest of the running pass) the download was served under;
  /// null for a saved list printed without a pass (free template, "made with" line).
  paymentId  String?
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  bytes      Int
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([listId, createdAt])
  @@index([paymentId])
}

/// One photo read into guests (routes/ai.ts): who, and when. Photo reading comes with a running
/// access pass, `PHOTO_READS_PER_PASS` reads per pass, counted over the running access window
/// (services/photoQuota.ts); this row is what enforces it, so a restart or a second API instance
/// does not reset the count. A read that found no names is deleted again. Nothing of the photo is
/// kept. Owned like a list — an account or a browser's guest key, moved to the account on sign-in
/// (services/guestLists.ts). Rows a year old are swept (services/retentionSweep.ts).
model PhotoRead {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKeyHash String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([guestKeyHash, createdAt])
  @@index([createdAt])
}
