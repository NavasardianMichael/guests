# The API's env. Read only by src/config.ts (+ src/load-env.ts, which loads, highest first:
# .env.<NODE_ENV>.local > .env.local > .env.<NODE_ENV> > .env). `pnpm install` copies this file
# to server/.env when that is missing. Production: server/.env.production.local, shipped as the
# ENV_API_BASE64 secret (`pnpm env:base64 production`) — every key here except the last
# section (local dev only).
#
# This is every variable the API reads: src/config.ts, plus DATABASE_URL for Prisma. Each says
# whether it is Required (no fallback), Required in production (the fallback is a dev value)
# or Optional (empty or unset turns a feature off or keeps a default).

# --- Database -----------------------------------------------------------------
# Required. docker-compose.yml publishes Postgres on 5010. Production: 127.0.0.1 (never
# localhost) and the password from $APP_DIR/db/.env — see deployment/db.env.example.
DATABASE_URL="postgresql://guests:guests@localhost:5010/guests?schema=public"

# Required in production (the fallback is a public dev secret). Signs the session JWT and the
# Google OAuth state cookie. `openssl rand -hex 64`.
# Rotating it signs every user out.
JWT_SECRET="change-me-in-production-use-long-random-string"

# Required in production. The exact origin serving the web app, no trailing slash — equal to
# the web's NEXT_PUBLIC_SITE_URL. CORS allows only it and requireSameOrigin compares against it.
CORS_ORIGIN="http://localhost:7010"

# Required in production. The API's own public origin — equal to the web's NEXT_PUBLIC_API_URL.
# Links back to the API (Google's redirect, the bank's /payments/return/<gateway>) are built on it.
API_PUBLIC_URL="http://localhost:9010"

# --- Google OAuth ---------------------------------------------------------------
# Optional. Google Cloud console > Credentials > OAuth client ID (Web application).
# Authorized redirect URI, exactly: http://localhost:9010/identity/google/callback
# (production: https://api.<domain>/identity/google/callback). Scopes: email, profile.
# Leave both empty to run without Google: the web app hides the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:9010/identity/google/callback"

# --- Photo import (AI) ------------------------------------------------------------
# Optional. Google AI Studio (https://aistudio.google.com/apikey) > Create API key. Photos of
# guest lists are sent to Gemini to be read (services/guestReader.ts). Empty: photo import is
# off and the web says so.
GEMINI_API_KEY=""

# --- Payments -------------------------------------------------------------------
# What is sold: one premium template, once, for every list its buyer makes (docs/PAYMENTS.md).
# `mock` (dev default: a fake bank page served by this API) or `ameria`.
# `mock` is refused when NODE_ENV=production: checkout answers 503.
PAYMENT_GATEWAY="mock"

# Ameriabank vPOS 3.1. Credentials come from the bank (vpos.support@ameriabank.am).
# Required in production with PAYMENT_GATEWAY="ameria".
AMERIA_CLIENT_ID=""
AMERIA_USERNAME=""
AMERIA_PASSWORD=""
# "true" = servicestest.ameriabank.am. The test terminal only accepts 10 AMD and an
# OrderID inside the range the bank assigns. Production: "false".
AMERIA_TEST_MODE="true"
# OrderID sent to the bank = this + Payment.orderNumber. Set it to the start of the range
# the bank gives for testing; in production, past every OrderID the test terminal saw.
AMERIA_ORDER_ID_OFFSET="0"
# Test terminal only: charge this instead of the real price. Remove in production.
# AMERIA_AMOUNT_OVERRIDE="10"

# --- Production only (leave empty or unset in dev) ------------------------------
# Required in production. Mail engine: sends sign-up verification, password-reset and
# "password changed" mail, and the contact form. Without it a password sign-up can never be
# verified, and the contact form answers 503. Empty in dev: links and messages print to this
# console instead.
MAIL_API_URL=""
MAIL_API_KEY=""

# Optional. The session cookie's Domain. Leave unset: it is derived (src/lib/cookie-domain.ts)
# — host-only in dev, CORS_ORIGIN's hostname in production, which covers the api. host beneath
# it. Set it only if the API is not a subdomain of the web host; "" forces a host-only cookie.
# COOKIE_DOMAIN=""

# Optional. "true" runs Chrome without its sandbox: a container running as root, or a host that
# blocks the sandbox (docs/PRODUCTION_SETUP.md step 2). Leave unset locally.
# PUPPETEER_NO_SANDBOX="true"

# --- Local dev only (production: written by the deploy — leave these out there) -----
# All optional: each has a default.
PORT=9010
# Interface to listen on; defaults to every one (0.0.0.0). Production: 127.0.0.1.
# HOST=127.0.0.1
NODE_ENV=development
# Where headless Chrome opens the web app's /render page to print a PDF. Defaults to
# CORS_ORIGIN. Production: http://127.0.0.1:7010, the web process over loopback.
# RENDER_ORIGIN="http://127.0.0.1:7010"
