# --- Database -----------------------------------------------------------------
# docker-compose.yml publishes Postgres on 5010.
DATABASE_URL="postgresql://guests:guests@localhost:5010/guests?schema=public"

# Signs the session JWT and the Google OAuth state cookie. `openssl rand -hex 64`.
# Rotating it signs every user out.
JWT_SECRET="change-me-in-production-use-long-random-string"

# The exact origin serving the web app, no trailing slash. requireSameOrigin compares
# against it, and in production its hostname becomes the session cookie's Domain.
CORS_ORIGIN="http://localhost:7010"

# The API's own public origin.
API_PUBLIC_URL="http://localhost:9010"

# Where headless Chrome opens the web app's /render page to print a PDF. Defaults to
# CORS_ORIGIN. Production: set by the deploy (http://127.0.0.1:7010) — leave it out there.
# RENDER_ORIGIN="http://127.0.0.1:7010"

# "true" runs Chrome without its sandbox: a container running as root, or a host whose
# AppArmor blocks the sandbox (docs/PRODUCTION_SETUP.md step 2). Leave unset locally.
# PUPPETEER_NO_SANDBOX="true"

# --- Mail engine (password-reset links) ---------------------------------------
# Empty in dev: the reset link prints to this console instead.
MAIL_API_URL=""
MAIL_API_KEY=""

# --- Google OAuth ---------------------------------------------------------------
# Google Cloud console > Credentials > OAuth client ID (Web application).
# Authorized redirect URI, exactly: http://localhost:9010/identity/google/callback
# (production: https://api.<domain>/identity/google/callback). Scopes: email, profile.
# Leave both empty to run without Google: the web app hides the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:9010/identity/google/callback"

# --- Photo import (AI) ------------------------------------------------------------
# Google AI Studio (https://aistudio.google.com/apikey) > Create API key. Photos of guest
# lists are sent to Gemini to be read (services/guestReader.ts). Empty: photo import is off
# and the web says so.
GEMINI_API_KEY=""
# Any Gemini model that reads images and answers JSON. Default: gemini-2.5-flash.
# GEMINI_MODEL="gemini-2.5-flash"

# --- Local dev only (production: set by the deploy, leave out) ---------------------
PORT=9010
# HOST=127.0.0.1
NODE_ENV=development
